{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Code knowledge graph (node-link)",
  "type": "object",
  "required": ["schema_version", "generated_at", "root_name", "directed", "stats", "nodes", "links", "communities", "analysis", "concepts", "tours"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string"},
    "root_name": {"type": "string"},
    "directed": {"type": "boolean"},
    "stats": {"type": "object", "required": ["nodes", "links", "files"], "properties": {"nodes": {"type": "integer"}, "links": {"type": "integer"}, "files": {"type": "integer"}}},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
    "communities": {"type": "array", "items": {"type": "object", "required": ["id", "name", "size", "top_members"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "label": {"type": "string"}, "size": {"type": "integer"}, "top_members": {"type": "array", "items": {"type": "string"}}}}},
    "analysis": {"type": "object", "required": ["hubs", "import_cycles", "entry_points", "orphan_files", "duplicate_names", "similar_lists", "surprising_links", "layers"]},
    "concepts": {"type": "array", "items": {"type": "object", "required": ["id", "name", "description", "nodes"],
      "properties": {"id": {"type": "string", "pattern": "^concept:"}, "name": {"type": "string", "minLength": 3}, "description": {"type": "string", "minLength": 20},
                     "nodes": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "tours": {"type": "array", "items": {"type": "object", "required": ["title", "steps"],
      "properties": {"title": {"type": "string"}, "steps": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["node", "why"],
        "properties": {"node": {"type": "string"}, "why": {"type": "string", "minLength": 10}}}}}}},
    "skipped_files": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "node": {"type": "object", "required": ["id", "type", "name", "file", "line", "lang", "layer", "tags", "summary", "degree"],
      "properties": {
        "id": {"type": "string", "minLength": 3},
        "type": {"enum": ["file", "module", "class", "function", "endpoint", "datastore", "external", "config"]},
        "name": {"type": "string"}, "file": {"type": "string"}, "line": {"type": "integer", "minimum": 0},
        "lang": {"type": "string"}, "kind": {"type": "string"}, "layer": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}}, "summary": {"type": "string", "maxLength": 400},
        "degree": {"type": "integer", "minimum": 0}, "community": {"type": "string"}}},
    "link": {"type": "object", "required": ["source", "target", "type", "confidence", "evidence"],
      "properties": {
        "source": {"type": "string"}, "target": {"type": "string"},
        "type": {"enum": ["contains", "imports", "calls", "extends", "implements", "exposes", "reads", "writes", "references", "maps_to", "manages", "uses", "loads", "fetches", "depends_on"]},
        "confidence": {"enum": ["EXTRACTED", "INFERRED", "AMBIGUOUS"]}, "evidence": {"type": "string"}}}
  }
}
