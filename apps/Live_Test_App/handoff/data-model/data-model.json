{
  "schema_version": "1.0",
  "model": {
    "name": "kyc-onboarding-desk",
    "description": "Target data model for the KYC onboarding desk: customer, identity document, case, scoring, screening and decisions as separate records. DRAFT: open questions answered with proposed defaults, none confirmed by an owner.",
    "dialect": "postgresql",
    "version": "0.3",
    "source_spec": "handoff/spec.md"
  },
  "enums": [
    {
      "name": "user_role",
      "values": [
        "analyst",
        "senior_analyst",
        "compliance_officer",
        "admin"
      ],
      "description": "Roles from the spec; mapping from the identity provider is open (Q-007) [Q-007]",
      "spec_refs": [
        "DM-005"
      ]
    },
    {
      "name": "id_type",
      "values": [
        "passport",
        "national_id",
        "driving_licence"
      ],
      "description": "ID document types seen in the prototype; full list open (Q-008) [FR-002, Q-008]"
    },
    {
      "name": "occupation",
      "values": [
        "engineer",
        "teacher",
        "government_official",
        "casino",
        "money_service",
        "car_dealer",
        "jewellery",
        "other"
      ],
      "description": "Occupation codes from the prototype form; list open (Q-008) [FR-002]",
      "spec_refs": [
        "BR-001"
      ]
    },
    {
      "name": "source_of_funds",
      "values": [
        "salary",
        "business",
        "inheritance",
        "other",
        "unknown"
      ],
      "description": "Source of funds codes from the prototype form [FR-002]",
      "spec_refs": [
        "BR-001"
      ]
    },
    {
      "name": "risk_rating",
      "values": [
        "low",
        "medium",
        "high"
      ],
      "description": "Risk rating derived from the score",
      "spec_refs": [
        "BR-003"
      ]
    },
    {
      "name": "case_status",
      "values": [
        "pending_review",
        "approved",
        "rejected",
        "escalated",
        "blocked"
      ],
      "description": "Case lifecycle; only pending_review and escalated accept decisions",
      "spec_refs": [
        "BR-008"
      ]
    },
    {
      "name": "screening_result",
      "values": [
        "clear",
        "pep_match",
        "sanctions_match",
        "unavailable"
      ],
      "description": "Outcome of a screening; unavailable is never treated as clear [FR-004]",
      "spec_refs": [
        "IN-002"
      ]
    },
    {
      "name": "rule_list_type",
      "values": [
        "high_risk_country",
        "cash_intensive_occupation"
      ],
      "description": "Kinds of list a risk rule set owns",
      "spec_refs": [
        "BR-001",
        "BR-002"
      ]
    },
    {
      "name": "decision_action",
      "values": [
        "approve",
        "reject",
        "escalate",
        "block",
        "release"
      ],
      "description": "A decision taken on a case; release is a placeholder for blocked-case handling (Q-005)",
      "spec_refs": [
        "DM-002",
        "BR-009"
      ]
    },
    {
      "name": "review_status",
      "values": [
        "scheduled",
        "completed",
        "cancelled"
      ],
      "description": "State of a periodic review (Q-004)",
      "spec_refs": [
        "BR-007"
      ]
    }
  ],
  "entities": [
    {
      "name": "app_user",
      "description": "A person known to the service, keyed by the identity provider subject; holds the role used for server-side authorisation. No passwords are stored. [FR-001, Q-007]",
      "classification": "Confidential",
      "audit": true,
      "rls": false,
      "retention": "Kept while any retained case or audit row refers to the user; deactivate, do not delete (proposed, Q-011)",
      "spec_refs": [
        "DM-005",
        "IN-001"
      ],
      "attributes": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Surrogate identifier",
          "default": "gen_random_uuid()",
          "primary_key": true
        },
        {
          "name": "directory_subject",
          "type": "varchar(100)",
          "nullable": false,
          "classification": "Confidential",
          "personal_data": false,
          "protection": "none",
          "description": "Subject id from the identity provider",
          "spec_refs": [
            "IN-001"
          ],
          "server_managed": true
        },
        {
          "name": "display_name",
          "type": "varchar(200)",
          "nullable": false,
          "classification": "Confidential",
          "personal_data": true,
          "protection": "none",
          "description": "Name shown in history and queues",
          "server_managed": true
        },
        {
          "name": "work_email",
          "type": "varchar(200)",
          "nullable": true,
          "classification": "Confidential",
          "personal_data": true,
          "protection": "none",
          "description": "Work email address",
          "server_managed": true
        },
        {
          "name": "role",
          "type": "enum:user_role",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Role used for permission checks (BR-004); assignment source per Q-007 [Q-007]",
          "spec_refs": [
            "BR-004"
          ],
          "server_managed": true
        },
        {
          "name": "is_active",
          "type": "boolean",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "False when access has been withdrawn; the row is kept for history",
          "default": "true"
        }
      ],
      "unique": [
        [
          "directory_subject"
        ]
      ]
    },
    {
      "name": "risk_rule_set",
      "description": "A versioned set of risk scoring rules: points, volume limits, rating thresholds, review cycle and approver per rating. Prototype values, unconfirmed (Q-001); owner not yet named. Cases store the version they were scored with. [FR-006, Q-001, Q-003, Q-004] Proposed decision: the scoring-module values (High 6+, Medium 3+, six countries) are used, matching REQ-0044 BR-5; the case page's second rule set is dropped (Q-001). Compliance owner to confirm.",
      "classification": "Internal",
      "audit": true,
      "reference_data": true,
      "retention": "Kept while any retained case refers to the rule version (proposed, Q-011)",
      "spec_refs": [
        "DM-004",
        "BR-001",
        "BR-003",
        "BR-004",
        "BR-007"
      ],
      "attributes": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Surrogate identifier",
          "default": "gen_random_uuid()",
          "primary_key": true
        },
        {
          "name": "rule_version",
          "type": "integer",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Rule version number stored on each scored case [FR-006]"
        },
        {
          "name": "effective_from",
          "type": "date",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Date the rule set applies from",
          "spec_refs": [
            "DM-004"
          ]
        },
        {
          "name": "points_high_risk_nationality",
          "type": "smallint",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Points when nationality is in the high-risk list",
          "spec_refs": [
            "BR-001"
          ]
        },
        {
          "name": "points_high_risk_residence",
          "type": "smallint",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Points when residence country is in the high-risk list",
          "spec_refs": [
            "BR-001"
          ]
        },
        {
          "name": "points_pep",
          "type": "smallint",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Points for a PEP",
          "spec_refs": [
            "BR-001"
          ]
        },
        {
          "name": "points_cash_intensive_occupation",
          "type": "smallint",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Points for a cash-intensive occupation",
          "spec_refs": [
            "BR-001"
          ]
        },
        {
          "name": "volume_high_limit",
          "type": "numeric(14,2)",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Monthly volume above this (exclusive) scores the high volume points",
          "spec_refs": [
            "BR-001"
          ]
        },
        {
          "name": "points_volume_high",
          "type": "smallint",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Points when volume is above the high limit",
          "spec_refs": [
            "BR-001"
          ]
        },
        {
          "name": "volume_medium_limit",
          "type": "numeric(14,2)",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Monthly volume above this (exclusive) scores the medium volume points",
          "spec_refs": [
            "BR-001"
          ]
        },
        {
          "name": "points_volume_medium",
          "type": "smallint",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Points when volume is above the medium limit",
          "spec_refs": [
            "BR-001"
          ]
        },
        {
          "name": "points_source_other_unknown",
          "type": "smallint",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Points when source of funds is other or unknown",
          "spec_refs": [
            "BR-001"
          ]
        },
        {
          "name": "points_not_face_to_face",
          "type": "smallint",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Points when the customer was not met face to face",
          "spec_refs": [
            "BR-001"
          ]
        },
        {
          "name": "high_min_score",
          "type": "smallint",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Score at or above this is High",
          "spec_refs": [
            "BR-003"
          ]
        },
        {
          "name": "medium_min_score",
          "type": "smallint",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Score at or above this (and below high) is Medium",
          "spec_refs": [
            "BR-003"
          ]
        },
        {
          "name": "review_years_high",
          "type": "smallint",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Years until next review for High [Q-004]",
          "spec_refs": [
            "BR-007"
          ]
        },
        {
          "name": "review_years_medium",
          "type": "smallint",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Years until next review for Medium [Q-004]",
          "spec_refs": [
            "BR-007"
          ]
        },
        {
          "name": "review_years_low",
          "type": "smallint",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Years until next review for Low [Q-004]",
          "spec_refs": [
            "BR-007"
          ]
        },
        {
          "name": "approver_role_high",
          "type": "enum:user_role",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Minimum role that may decide High cases [Q-003] Proposed: matrix enforced on the server, four-eyes required (Q-003).",
          "spec_refs": [
            "BR-004"
          ]
        },
        {
          "name": "approver_role_medium",
          "type": "enum:user_role",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Minimum role that may decide Medium cases [Q-003] Proposed: matrix enforced on the server, four-eyes required (Q-003).",
          "spec_refs": [
            "BR-004"
          ]
        },
        {
          "name": "approver_role_low",
          "type": "enum:user_role",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Minimum role that may decide Low cases [Q-003] Proposed: matrix enforced on the server, four-eyes required (Q-003).",
          "spec_refs": [
            "BR-004"
          ]
        },
        {
          "name": "auto_approve_low",
          "type": "boolean",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "True if Low cases are approved without human review; proposed false until Q-002 is answered [Q-002] Proposed: false, every case gets a human decision (REQ-0044 BR-6 says automatic; Q-002 to confirm).",
          "default": "false"
        }
      ],
      "unique": [
        [
          "rule_version"
        ]
      ],
      "checks": [
        {
          "name": "thresholds_ordered",
          "expression": "medium_min_score > 0 AND high_min_score > medium_min_score",
          "spec_refs": [
            "BR-003"
          ]
        },
        {
          "name": "volume_limits_ordered",
          "expression": "volume_medium_limit >= 0 AND volume_high_limit > volume_medium_limit",
          "spec_refs": [
            "BR-001"
          ]
        },
        {
          "name": "points_not_negative",
          "expression": "points_high_risk_nationality >= 0 AND points_high_risk_residence >= 0 AND points_pep >= 0 AND points_cash_intensive_occupation >= 0 AND points_volume_high >= 0 AND points_volume_medium >= 0 AND points_source_other_unknown >= 0 AND points_not_face_to_face >= 0",
          "spec_refs": [
            "BR-001"
          ]
        },
        {
          "name": "review_years_positive",
          "expression": "review_years_high > 0 AND review_years_medium > 0 AND review_years_low > 0",
          "spec_refs": [
            "BR-007"
          ]
        }
      ],
      "seed": [
        {
          "id": "00000000-0000-4000-8000-000000000001",
          "rule_version": 1,
          "effective_from": "2025-01-01",
          "points_high_risk_nationality": 3,
          "points_high_risk_residence": 3,
          "points_pep": 3,
          "points_cash_intensive_occupation": 2,
          "volume_high_limit": 50000,
          "points_volume_high": 2,
          "volume_medium_limit": 10000,
          "points_volume_medium": 1,
          "points_source_other_unknown": 2,
          "points_not_face_to_face": 1,
          "high_min_score": 6,
          "medium_min_score": 3,
          "review_years_high": 1,
          "review_years_medium": 2,
          "review_years_low": 3,
          "approver_role_high": "compliance_officer",
          "approver_role_medium": "senior_analyst",
          "approver_role_low": "analyst",
          "auto_approve_low": false
        }
      ]
    },
    {
