          "columns": [
            "entity_name",
            "entity_id"
          ]
        },
        {
          "columns": [
            "occurred_at"
          ]
        }
      ]
    },
    {
      "name": "customer",
      "description": "The person being onboarded, held once however many cases or documents they have. Separates who the customer is from each onboarding attempt.",
      "classification": "Restricted",
      "audit": true,
      "rls": true,
      "retention": "5 years after the customer relationship ends (proposed, Q-011)",
      "spec_refs": [
        "DM-001"
      ],
      "attributes": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Surrogate identifier",
          "primary_key": true,
          "default": "gen_random_uuid()"
        },
        {
          "name": "full_name",
          "type": "varchar(200)",
          "nullable": false,
          "classification": "Confidential",
          "personal_data": true,
          "protection": "encrypted_at_rest",
          "description": "Customer full name"
        },
        {
          "name": "date_of_birth",
          "type": "date",
          "nullable": false,
          "classification": "Restricted",
          "personal_data": true,
          "protection": "encrypted_at_rest",
          "description": "Date of birth; at least 18 on the day of the case (BR-005). Unmasked only for compliance_officer (proposed, Q-010)",
