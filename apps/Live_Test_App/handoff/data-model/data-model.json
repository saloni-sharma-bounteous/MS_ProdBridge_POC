    {
      "name": "audit_log",
      "description": "Append-only record of views, exports, changes and configuration edits across the service (who, what, when, before and after). Design decision: covers events DM-002 does not, such as case views and CSV exports (REQ-0044 FR-8).",
      "classification": "Restricted",
      "audit": false,
      "rls": true,
      "retention": "5 years after the related case's relationship ends; never edited or deleted before then (proposed, Q-011, NF-004)",
      "spec_refs": [
        "NF-003",
        "NF-004"
      ],
      "attributes": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Surrogate identifier",
          "default": "gen_random_uuid()",
          "primary_key": true
        },
        {
          "name": "entity_name",
          "type": "varchar(60)",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Table the action touched",
          "server_managed": true
        },
        {
          "name": "entity_id",
          "type": "uuid",
          "nullable": true,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "Row the action touched; null for an export of many rows",
          "server_managed": true
        },
        {
          "name": "action",
          "type": "varchar(30)",
          "nullable": false,
          "classification": "Internal",
          "personal_data": false,
          "protection": "none",
          "description": "What happened, for example view, create, update, export",
          "server_managed": true
        },
        {
          "name": "actor",
          "type": "varchar(100)",
          "nullable": false,
          "classification": "Confidential",
          "personal_data": true,
          "protection": "none",
          "description": "Identity provider subject of the user or service",
